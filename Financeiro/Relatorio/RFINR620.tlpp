#Include "Protheus.ch"
#Include "TopConn.ch"
#Include "RPTDEF.ch"
#Include "FWPrintSetup.ch"

/*/{Protheus.doc} RFINR620
Relatório Customizado de Movimentação Bancária - Analítico por Banco
Com busca de Centro de Custo (SD1/SC7/SE2), Rateio de Movimentos
e Layout impresso em FWMSPrinter reproduzindo o padrão visual do SmartView.
@type function
@author Elvis Siqueira
/*/
User Function RFINR620()
    Local oPrinter := Nil
    Local oProcess := Nil
    
    If Pergunte("FIN620", .T.)
        oPrinter := FWMSPrinter():New("RFINR620", IMP_PDF, .F., "", .T., , @oPrinter, , , , , .T.)
        oPrinter:cPathPDF := GetTempPath(.T., .F.)
        oPrinter:SetResolution(72)
        oPrinter:SetLandscape()
        oPrinter:SetPaperSize(DMPAPER_A4)
        oPrinter:SetMargin(60, 60, 60, 60)
        
        oProcess := MsNewProcess():New({|| ImprimeReport(oPrinter, oProcess)}, "Processando", "Gerando Extrato Bancário...", .F.)
        oProcess:Activate()
        
        If ValType(oPrinter) == "O"
            FreeObj(oPrinter)
            oPrinter := Nil
        EndIf
    EndIf
Return

Static Function ImprimeReport(oPrinter, oProc)
    Local cQry           := ""
    Local cAliasQry      := GetNextAlias()
    Local cLogoEmp       := fLogoEmp()
    
    Local nLinCabec      := 115
    Local nLinInicio     := 135
    Local nLinQuebra     := 115
    Local nLinLimite     := 500
    Local nAltLinha      := 14
    Local nLinha         := nLinInicio
    Local nPagina        := 0
    
    Local nTotEntrada    := 0
    Local nTotSaida      := 0
    Local nSaldoAtual    := 0
    Local nSaldoIni      := 0
    Local aCCustos       := {}
    Local nI             := 0
    Local nVlrRateio     := 0
    Local cBancoAtual    := ""
    Local cAgenciaAtual  := ""
    Local cContaAtual    := ""
    Local lImprimou      := .F.
    Local nTotalPaginas  := 0
    Local nTotalRegistros:= 0
    Local nRegProcessados:= 0
    Local aCacheCC       := {}
    Local aCacheSaldo    := {}
    Local nCacheCCIdx    := 0
    Local nCacheSldIdx   := 0
    
    // Instância da fonte Times New Roman em destaque
    Local oFontHead      := TFont():New("Times New Roman", , -13, , .T.)
    Local oFontSub       := TFont():New("Times New Roman", , -8, , .F.)
    Local oFontBold      := TFont():New("Times New Roman", , -8, , .T.)
    Local oFontBody      := TFont():New("Times New Roman", , -7.5, , .F.)

    // Query principal de busca das movimentações bancárias (SE5 -> SE2)
    cQry := " SELECT "
    cQry += "     SE5.E5_FILIAL, SE5.E5_DTDISPO, SE5.E5_NATUREZ, SE5.E5_PREFIXO, "
    cQry += "     SE5.E5_NUMERO, SE5.E5_PARCELA, SE5.E5_TIPO, SE5.E5_CLIFOR, SE5.E5_LOJA, "
    cQry += "     SE5.E5_BANCO, SE5.E5_AGENCIA, SE5.E5_CONTA, SE5.E5_NUMCHEQ, SE5.E5_DOCUMEN, "
    cQry += "     SE5.E5_RECPAG, SE5.E5_VALOR, SE5.E5_HISTOR, "
    cQry += "     ISNULL(SE2.E2_ORIGEM, '') AS E2_ORIGEM, ISNULL(SE2.E2_CCUSTO, '') AS E2_CCUSTO "
    cQry += " FROM " + RetSqlName("SE5") + " SE5 "
    cQry += " LEFT JOIN " + RetSqlName("SE2") + " SE2 ON "
    cQry += "     SE2.E2_FILIAL  = SE5.E5_FILIAL  AND SE2.E2_PREFIXO = SE5.E5_PREFIXO AND "
    cQry += "     SE2.E2_NUM     = SE5.E5_NUMERO   AND SE2.E2_TIPO    = SE5.E5_TIPO    AND "
    cQry += "     SE2.E2_PARCELA = SE5.E5_PARCELA  AND SE2.E2_FORNECE = SE5.E5_CLIFOR  AND "
    cQry += "     SE2.E2_LOJA    = SE5.E5_LOJA     AND SE2.D_E_L_E_T_ = ' ' "
    cQry += " WHERE "
    cQry += "     SE5.E5_DTDISPO >= '" + DToS(MV_PAR01) + "' AND SE5.E5_DTDISPO <= '" + DToS(MV_PAR02) + "' AND "
    cQry += "     SE5.E5_BANCO   >= '" + MV_PAR03 + "' AND SE5.E5_BANCO   <= '" + MV_PAR04 + "' AND "
    cQry += "     SE5.E5_NATUREZ >= '" + MV_PAR05 + "' AND SE5.E5_NATUREZ <= '" + MV_PAR06 + "' AND "
    cQry += "     SE5.E5_DTDIGIT >= '" + DToS(MV_PAR07) + "' AND SE5.E5_DTDIGIT <= '" + DToS(MV_PAR08) + "' AND "
    If Type("MV_PAR13") != "U" .And. !Empty(MV_PAR13)
        cQry += " SE5.E5_FILIAL >= '" + MV_PAR13 + "' AND SE5.E5_FILIAL <= '" + MV_PAR14 + "' AND "
    EndIf
    cQry += "     SE5.E5_SITUACA <> 'C' AND SE5.D_E_L_E_T_ = ' ' "
    cQry += " ORDER BY SE5.E5_BANCO, SE5.E5_AGENCIA, SE5.E5_CONTA, SE5.E5_DTDISPO, SE5.R_E_C_N_O_ "

    TcQuery cQry New Alias (cAliasQry)

    nTotalRegistros := (cAliasQry)->(LastRec())

    // 1ª Passada: Simulação de paginação
    nTotalPaginas := SimulaPaginacao(cAliasQry, nLinInicio, nLinQuebra, nAltLinha, nLinLimite, @aCacheCC, @aCacheSaldo)

    (cAliasQry)->(DbGoTop())

    // 2ª Passada: Impressão efetiva
    While !(cAliasQry)->(Eof())
        lImprimou := .T.
        
        If (cAliasQry)->(E5_BANCO + E5_AGENCIA + E5_CONTA) != (cBancoAtual + cAgenciaAtual + cContaAtual)
            If !Empty(cBancoAtual)
                ImprimeTotais(oPrinter, nTotEntrada, nTotSaida, nSaldoAtual, nLinha, oFontBold)
                ImprimeRodape(oPrinter, nPagina, nTotalPaginas, nRegProcessados, nTotalRegistros, oFontSub)
                oPrinter:EndPage()
            EndIf

            cBancoAtual   := (cAliasQry)->E5_BANCO
            cAgenciaAtual := (cAliasQry)->E5_AGENCIA
            cContaAtual   := (cAliasQry)->E5_CONTA
            
            nCacheSldIdx++
            nSaldoIni   := aCacheSaldo[nCacheSldIdx]
            nSaldoAtual := nSaldoIni
            nTotEntrada := 0
            nTotSaida   := 0
            nPagina++

            oPrinter:StartPage()
            CabecSmartView(oPrinter, cLogoEmp, cBancoAtual, cAgenciaAtual, cContaAtual, nSaldoIni, oFontHead, oFontSub, oFontBold)
            nLinha := nLinCabec
            ImprimeColunas(oPrinter, nLinha, oFontBold)
            nLinha := nLinInicio
        EndIf

        nCacheCCIdx++
        aCCustos := aCacheCC[nCacheCCIdx]
        nVlrRateio := Round((cAliasQry)->E5_VALOR / Len(aCCustos), 2)

        For nI := 1 To Len(aCCustos)
            
            If nLinha > nLinLimite
                ImprimeRodape(oPrinter, nPagina, nTotalPaginas, nRegProcessados, nTotalRegistros, oFontSub)
                oPrinter:EndPage()
                nPagina++
                oPrinter:StartPage()
                CabecSmartView(oPrinter, cLogoEmp, cBancoAtual, cAgenciaAtual, cContaAtual, nSaldoIni, oFontHead, oFontSub, oFontBold)
                nLinha := nLinQuebra
                ImprimeColunas(oPrinter, nLinha, oFontBold)
                nLinha := nLinQuebra + 20
            EndIf

            // Efeito Zebrado
            If (nLinha / nAltLinha) % 2 == 0
                oPrinter:FillRect({nLinha - 2, 15, nLinha + 11, 825}, oPrinter:SetBrush(1, 245, 245, 245))
            EndIf

            oPrinter:Say(nLinha, 20 , (cAliasQry)->E5_FILIAL, oFontBody)
            oPrinter:Say(nLinha, 60 , DToC(SToD((cAliasQry)->E5_DTDISPO)), oFontBody)
            oPrinter:Say(nLinha, 115, SubStr((cAliasQry)->E5_NATUREZ, 1, 12), oFontBody)
            oPrinter:Say(nLinha, 185, SubStr(aCCustos[nI], 1, 22), oFontBody)
            oPrinter:Say(nLinha, 310, (cAliasQry)->E5_PREFIXO + " " + (cAliasQry)->E5_NUMERO + " " + (cAliasQry)->E5_PARCELA, oFontBody)
            oPrinter:Say(nLinha, 410, (cAliasQry)->E5_NUMCHEQ, oFontBody)

            If (cAliasQry)->E5_RECPAG == "R"
                nSaldoAtual += nVlrRateio
                nTotEntrada += nVlrRateio
                oPrinter:SayAlign(nLinha, 480, Transform(nVlrRateio, "@E 999,999,999.92"), oFontBody, 70, 07, , 1, )
                oPrinter:SayAlign(nLinha, 560, "0,00", oFontBody, 70, 07, , 1, )
            Else
                nSaldoAtual -= nVlrRateio
                nTotSaida   += nVlrRateio
                oPrinter:SayAlign(nLinha, 480, "0,00", oFontBody, 70, 07, , 1, )
                oPrinter:SayAlign(nLinha, 560, Transform(nVlrRateio, "@E 999,999,999.92"), oFontBody, 70, 07, , 1, )
            EndIf

            oPrinter:SayAlign(nLinha, 640, Transform(nSaldoAtual, "@E 999,999,999.92"), oFontBody, 70, 07, , 1, )
            oPrinter:Say(nLinha, 720, SubStr((cAliasQry)->E5_HISTOR, 1, 22), oFontBody)

            nLinha += nAltLinha
        Next nI

        nRegProcessados++
        (cAliasQry)->(DbSkip())
    EndDo

    If lImprimou
        ImprimeTotais(oPrinter, nTotEntrada, nTotSaida, nSaldoAtual, nLinha, oFontBold)
        ImprimeRodape(oPrinter, nPagina, nTotalPaginas, nRegProcessados, nTotalRegistros, oFontSub)
        oPrinter:EndPage()
    Else
        SA6->(DbSetOrder(1))
        If SA6->(MsSeek(xFilial("SA6") + MV_PAR03))
            cBancoAtual   := SA6->A6_COD
            cAgenciaAtual := SA6->A6_AGENCIA
            cContaAtual   := SA6->A6_NUMCON
        Else
            cBancoAtual   := MV_PAR03
            cAgenciaAtual := ""
            cContaAtual   := ""
        EndIf
        
        nSaldoIni := GetSaldoIni(cBancoAtual, cAgenciaAtual, cContaAtual, MV_PAR01)
        nPagina   := 1

        oPrinter:StartPage()
        CabecSmartView(oPrinter, cLogoEmp, cBancoAtual, cAgenciaAtual, cContaAtual, nSaldoIni, oFontHead, oFontSub, oFontBold)
        nLinha := nLinCabec
        ImprimeColunas(oPrinter, nLinha, oFontBold)
        
        nLinha += 25
        oPrinter:Say(nLinha, 20, "Não existem lançamentos no período selecionado.", oFontBody)
        
        ImprimeTotais(oPrinter, 0, 0, nSaldoIni, nLinha + 15, oFontBold)
        ImprimeRodape(oPrinter, nPagina, nTotalPaginas, 0, nTotalRegistros, oFontSub)
        oPrinter:EndPage()
    EndIf
    
    oPrinter:Preview()

    (cAliasQry)->(DbCloseArea())

    FreeObj(oFontHead)
    FreeObj(oFontSub)
    FreeObj(oFontBold)
    FreeObj(oFontBody)

    oFontHead  := Nil
    oFontSub   := Nil
    oFontBold  := Nil
    oFontBody  := Nil
Return

Static Function SimulaPaginacao(cAliasQry, nLinInicio, nLinQuebra, nAltLinha, nLinLimite, aCacheCC, aCacheSaldo)
    Local nLinhaSim      := nLinInicio
    Local nPagSim        := 0
    Local cBancoSim      := ""
    Local cAgenciaSim    := ""
    Local cContaSim      := ""
    Local aCC            := {}
    Local nI             := 0
    Local lAlgumRegistro := .F.

    While !(cAliasQry)->(Eof())
        lAlgumRegistro := .T.

        If (cAliasQry)->(E5_BANCO + E5_AGENCIA + E5_CONTA) != (cBancoSim + cAgenciaSim + cContaSim)
            If !Empty(cBancoSim)
                nPagSim++
            EndIf
            cBancoSim   := (cAliasQry)->E5_BANCO
            cAgenciaSim := (cAliasQry)->E5_AGENCIA
            cContaSim   := (cAliasQry)->E5_CONTA
            AAdd(aCacheSaldo, GetSaldoIni(cBancoSim, cAgenciaSim, cContaSim, MV_PAR01))
            nLinhaSim := nLinInicio
        EndIf

        aCC := GetCCusto((cAliasQry)->E5_FILIAL, (cAliasQry)->E5_PREFIXO, (cAliasQry)->E5_NUMERO, ;
                         (cAliasQry)->E5_TIPO, (cAliasQry)->E5_PARCELA, (cAliasQry)->E5_CLIFOR, ;
                         (cAliasQry)->E5_LOJA, (cAliasQry)->E2_ORIGEM, (cAliasQry)->E2_CCUSTO)

        If Len(aCC) == 0
            AAdd(aCC, "")
        EndIf
        AAdd(aCacheCC, aCC)

        For nI := 1 To Len(aCC)
            If nLinhaSim > nLinLimite
                nPagSim++
                nLinhaSim := nLinQuebra + 20
            EndIf
            nLinhaSim += nAltLinha
        Next nI

        (cAliasQry)->(DbSkip())
    EndDo

    If lAlgumRegistro
        nPagSim++
    Else
        nPagSim := 1
    EndIf

Return nPagSim

/*---------------------------------------------------------------------*
 | Func:  CabecSmartView                                               |
 | Desc:  Monta o cabeçalho no padrão SmartView sem linhas duplicadas  |
 *---------------------------------------------------------------------*/
Static Function CabecSmartView(oPrinter, cLogoEmp, cBanco, cAgencia, cConta, nSaldoIni, oFontHead, oFontSub, oFontBold)
    Local nLinCab   := 60
    Local nColIni   := 15
    Local nColFin   := 825
    
    Local oFontExpLbl := TFont():New("Times New Roman", , -8, , .T.)
    Local oFontExpVal := TFont():New("Times New Roman", , -9, , .F.)

    // 1. Logo da Empresa à esquerda
    If File(cLogoEmp)
        oPrinter:SayBitmap(nLinCab - 5, nColIni, cLogoEmp, 28, 28)
    EndIf

    // 2. Título Principal em Times New Roman
    oPrinter:Say(nLinCab + 4, nColIni + 35, "SIGAFIN - Relação da Movimentação Bancária - Analítico - por Banco", oFontHead)

    // 3. Bloco "Data de Expedição" à direita
    oPrinter:Say(nLinCab, nColFin - 140, "Data de", oFontExpLbl)
    oPrinter:Say(nLinCab, nColFin - 75,  DToC(dDataBase) + " " + Time(), oFontExpVal)
    oPrinter:Say(nLinCab + 10, nColFin - 140, "Expedição", oFontExpLbl)

    nLinCab += 15

    // 4. Linha Superior da faixa do Banco
    oPrinter:Line(nLinCab, nColIni, nLinCab, nColFin)

    nLinCab += 12

    // 5. Linha de Dados do Banco
    oPrinter:Say(nLinCab, nColIni,        "Banco: " + AllTrim(cBanco), oFontBold)
    oPrinter:Say(nLinCab, nColIni + 110,  "Agência: " + AllTrim(cAgencia), oFontBold)
    oPrinter:Say(nLinCab, nColIni + 230,  "Conta: " + AllTrim(cConta), oFontBold)
    oPrinter:Say(nLinCab, nColIni + 370,  "Saldo Anterior: " + AllTrim(Transform(nSaldoIni, "@E 999,999,999.99")), oFontBold)
    oPrinter:Say(nLinCab, nColIni + 535,  "Dt. Saldo Anterior: " + DToC(MV_PAR01), oFontBold)
    oPrinter:Say(nLinCab, nColIni + 695,  "Moeda: REAL", oFontBold)

    nLinCab += 10

    // 6. Linha Inferior da faixa do Banco
    oPrinter:Line(nLinCab, nColIni, nLinCab, nColFin)

    nLinCab += 10

    FreeObj(oFontExpLbl)
    FreeObj(oFontExpVal)
Return

Static Function ImprimeColunas(oPrinter, nLinha, oFontBold)
    
    oPrinter:Say(nLinha + 3, 20 , "Filial", oFontBold)
    oPrinter:Say(nLinha + 3, 60 , "Data Mov", oFontBold)
    oPrinter:Say(nLinha + 3, 115, "Natureza", oFontBold)
    oPrinter:Say(nLinha + 3, 185, "Centro de Custo", oFontBold)
    oPrinter:Say(nLinha + 3, 310, "Documento", oFontBold)
    oPrinter:Say(nLinha + 3, 410, "Num Cheque", oFontBold)
    oPrinter:Say(nLinha + 3, 480, "Mov.Entrada", oFontBold)
    oPrinter:Say(nLinha + 3, 560, "Mov.Saida", oFontBold)
    oPrinter:Say(nLinha + 3, 640, "Saldo Atual", oFontBold)
    oPrinter:Say(nLinha + 3, 720, "Histórico", oFontBold)
    oPrinter:Line(nLinha + 15, 15, nLinha + 15, 825)

Return

Static Function ImprimeTotais(oPrinter, nEntrada, nSaida, nSaldoAtu, nLinha, oFontBold)
    
    nLinha += 5
    oPrinter:Line(nLinha, 15, nLinha, 825)
    oPrinter:Say(nLinha + 5, 20, "Resumo:", oFontBold)
    oPrinter:SayAlign(nLinha + 5, 480, Transform(nEntrada, "@E 999,999,999.92"), oFontBold, 70, 07, , 1, )
    oPrinter:SayAlign(nLinha + 5, 560, Transform(nSaida, "@E 999,999,999.92"), oFontBold, 70, 07, , 1, )
    oPrinter:SayAlign(nLinha + 5, 640, Transform(nSaldoAtu, "@E 999,999,999.92"), oFontBold, 70, 07, , 1, )
    oPrinter:Line(nLinha + 17, 15, nLinha + 17, 825)

Return

Static Function ImprimeRodape(oPrinter, nPagina, nTotalPaginas, nRegAtual, nTotalReg, oFontSub)
    Local nLinhaRodape := 545

    oPrinter:Line(nLinhaRodape, 15, nLinhaRodape, 825)
    oPrinter:Say(nLinhaRodape + 6, 20, "TOTVS", oFontSub)
    oPrinter:SayAlign(nLinhaRodape + 6, 360, AllTrim(Str(nPagina)) + "/" + AllTrim(Str(nTotalPaginas)), oFontSub, 100, 07, , 2, )
    oPrinter:SayAlign(nLinhaRodape + 6, 680, AllTrim(Str(nRegAtual)) + " de " + AllTrim(Str(nTotalReg)) + " registros", oFontSub, 140, 07, , 1, )
Return

Static Function fLogoEmp()
    Local cGrpCompany := AllTrim(FWGrpCompany())
    Local cCodEmpGrp  := AllTrim(FWCodEmp())
    Local cUnitGrp    := AllTrim(FWUnitBusiness())
    Local cFilGrp     := AllTrim(FWFilial())
    Local cLogo       := ""
    Local cCamFim     := GetTempPath(.T., .T.)
    Local cStart      := GetSrvProfString("Startpath", "")
    Local cDescLogo   := ""

    If !Empty(cUnitGrp)
        cDescLogo := cGrpCompany + cCodEmpGrp + cUnitGrp + cFilGrp
    Else
        cDescLogo := cEmpAnt + cFilAnt
    EndIf
    
    cLogo := cStart + "LGMID" + cDescLogo + ".PNG"
    
    If !File(cLogo)
        cLogo := cStart + "LGMID" + cEmpAnt + ".PNG"
    EndIf
    
    CpyS2T(cLogo, cCamFim)
    cLogo := cCamFim + StrTran(cLogo, cStart, "")
    
    If !File(cLogo)
        Sleep(500)
    EndIf
Return cLogo

Static Function GetCCusto(cFilSE5, cPrefixo, cNumero, cTipo, cParcela, cFornece, cLoja, cOrigem, cCCE2)
    Local aCC      := {}
    Local cQryCC   := ""
    Local cAliasCC := GetNextAlias()
    Local cFilCTT  := xFilial("CTT")

    If AllTrim(cOrigem) != "MATA100" .And. !Empty(cCCE2)
        AAdd(aCC, FormatCC(cCCE2, cFilCTT))
        Return aCC
    EndIf

    cQryCC := " SELECT DISTINCT TMP.CCUSTO, ISNULL(CTT.CTT_DESC01, '') AS CTT_DESC01 FROM ( "
    cQryCC += "     SELECT D1_CC AS CCUSTO "
    cQryCC += "     FROM " + RetSqlName("SD1") + " SD1 "
    cQryCC += "     WHERE SD1.D1_FILIAL = '" + cFilSE5 + "' AND SD1.D1_SERIE = '" + cPrefixo + "' "
    cQryCC += "       AND SD1.D1_DOC = '" + cNumero + "' AND SD1.D1_FORNECE = '" + cFornece + "' "
    cQryCC += "       AND SD1.D1_LOJA = '" + cLoja + "' AND SD1.D1_CC <> '' AND SD1.D_E_L_E_T_ = ' ' "
    cQryCC += "     UNION "
    cQryCC += "     SELECT C7_CC AS CCUSTO "
    cQryCC += "     FROM " + RetSqlName("SD1") + " SD1 "
    cQryCC += "     INNER JOIN " + RetSqlName("SC7") + " SC7 ON SC7.C7_FILIAL = SD1.D1_FILIAL AND SC7.C7_NUM = SD1.D1_PEDIDO AND SC7.D_E_L_E_T_ = ' ' "
    cQryCC += "     WHERE SD1.D1_FILIAL = '" + cFilSE5 + "' AND SD1.D1_SERIE = '" + cPrefixo + "' "
    cQryCC += "       AND SD1.D1_DOC = '" + cNumero + "' AND SD1.D1_FORNECE = '" + cFornece + "' "
    cQryCC += "       AND SD1.D1_LOJA = '" + cLoja + "' AND SC7.C7_CC <> '' AND SD1.D_E_L_E_T_ = ' ' "
    cQryCC += " ) TMP "
    cQryCC += " LEFT JOIN " + RetSqlName("CTT") + " CTT ON "
    cQryCC += "     CTT.CTT_FILIAL = '" + cFilCTT + "' AND CTT.CTT_CUSTO = TMP.CCUSTO AND CTT.D_E_L_E_T_ = ' ' "

    TcQuery cQryCC New Alias (cAliasCC)

    While !(cAliasCC)->(Eof())
        If !Empty((cAliasCC)->CTT_DESC01)
            AAdd(aCC, AllTrim((cAliasCC)->CCUSTO) + " - " + AllTrim((cAliasCC)->CTT_DESC01))
        Else
            AAdd(aCC, AllTrim((cAliasCC)->CCUSTO))
        EndIf
        (cAliasCC)->(DbSkip())
    EndDo

    (cAliasCC)->(DbCloseArea())

    If Len(aCC) == 0 .And. !Empty(cCCE2)
        AAdd(aCC, FormatCC(cCCE2, cFilCTT))
    EndIf

Return aCC

Static Function FormatCC(cCodCC, cFilCTT)
    Local cDesc := Posicione("CTT", 1, cFilCTT + cCodCC, "CTT_DESC01")
    If !Empty(cDesc)
        Return AllTrim(cCodCC) + " - " + AllTrim(cDesc)
    EndIf
Return AllTrim(cCodCC)

Static Function GetSaldoIni(cBanco, cAgencia, cConta, dData)
    Local nSaldo    := 0
    Local cQrySld   := ""
    Local cAliasSld := GetNextAlias()

    cQrySld := " SELECT TOP 1 E8_SALATUA FROM " + RetSqlName("SE8") + " "
    cQrySld += " WHERE E8_BANCO = '" + cBanco + "' AND E8_AGENCIA = '" + cAgencia + "' "
    cQrySld += "   AND E8_CONTA = '" + cConta + "' AND E8_DTSALAT < '" + DToS(dData) + "' "
    cQrySld += "   AND D_E_L_E_T_ = ' ' ORDER BY E8_DTSALAT DESC "

    TcQuery cQrySld New Alias (cAliasSld)

    If !(cAliasSld)->(Eof())
        nSaldo := (cAliasSld)->E8_SALATUA
    EndIf

    (cAliasSld)->(DbCloseArea())
Return nSaldo
